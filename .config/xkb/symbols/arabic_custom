
// Arabic (Custom Phonetic) layout
// Author: Osman Semir :) — based on XKB standard and mac-phonetic mapping
// Save as ~/.config/xkb/symbols/arabic_custom
// Use with: kb_layout = us,arabic_custom | kb_variant = ,phonetic

default partial alphanumeric_keys
xkb_symbols "phonetic" {
    name[Group1] = "Arabic (Custom Phonetic)";

    // Top row -------------------------------------------------------
    key <TLDE> { [ grave, asciitilde ] }; // leave normal
    key <AE01> { [ 1, exclam ] };
    key <AE02> { [ 2, at ] };
    key <AE03> { [ 3, numbersign ] };
    key <AE04> { [ 4, dollar ] };
    key <AE05> { [ 5, percent ] };
    key <AE06> { [ 6, asciicircum ] };
    key <AE07> { [ 7, ampersand ] };
    key <AE08> { [ 8, asterisk ] };
    key <AE09> { [ 9, parenleft ] };
    key <AE10> { [ 0, parenright ] };
    key <AE11> { [ minus, underscore ] };
    key <AE12> { [ equal, plus ] };

    // QWERTY row ----------------------------------------------------
    key <AD01> { [ Arabic_qaf,Arabic_qaf] };
    key <AD02> { [ Arabic_waw, Arabic_hamzaonwaw ] };
    key <AD03> { [ Arabic_yeh,  Arabic_yeh  ] };
    key <AD04> { [ Arabic_ra, Arabic_ra] };
    key <AD05> { [ Arabic_teh, Arabic_theh ] };
    key <AD06> { [ Arabic_yeh, Arabic_hamzaonyeh ] };
    key <AD07> { [ Arabic_tehmarbuta, Arabic_tehmarbuta ] };
    key <AD08> { [ Arabic_hamzaunderalef, Arabic_alefmaksura ] };
    key <AD09> { [ Arabic_ain, Arabic_ain ] };
    key <AD10> { [ Arabic_gaf, Arabic_qaf ] };
    key <AD11> { [ bracketleft, braceleft ] };
    key <AD12> { [ bracketright, braceright ] };

    // Home row ------------------------------------------------------
    key <AC01> { [ Arabic_alef, Arabic_hamzaonalef ] };
    key <AC02> { [ Arabic_seen, Arabic_sheen] };
    key <AC03> { [ Arabic_dal, Arabic_thal ] };
    key <AC04> { [ Arabic_feh, Arabic_qaf ] };
    key <AC05> { [ Arabic_ghain, Arabic_ghain    ] };
    key <AC06> { [ Arabic_heh, Arabic_hah ] };
    key <AC07> { [ Arabic_jeem, Arabic_jeem    ] };
    key <AC08> { [ Arabic_kaf, Arabic_khah ] };
    key <AC09> { [ Arabic_lam, Arabic_lam_alef ] };
    key <AC10> { [ semicolon, Arabic_semicolon ] };
    key <AC11> { [ apostrophe, Arabic_hamza ] };

    // Bottom row ----------------------------------------------------
    key <AB01> { [ Arabic_zain, Arabic_zain] };
    key <AB02> { [ Arabic_sad, Arabic_dad ] };
    key <AB03> { [ Arabic_tah, Arabic_zah ] };
    key <AB04> { [ Arabic_hamza, Arabic_hamza  ] };
    key <AB05> { [ Arabic_beh, Arabic_beh ] };
    key <AB06> { [Arabic_noon, Arabic_noon] };
    key <AB07> { [Arabic_meem, Arabic_meem] };
    key <AB08> { [ Arabic_comma, comma ] };
    key <AB09> { [ period, Arabic_fullstop ] };
    key <AB10> { [ slash, Arabic_question_mark ] };

    // Space & modifiers ---------------------------------------------
    key <SPCE> { [ space, Arabic_tatweel ] };              // Space / ـ

    include "level3(ralt_switch)"
};
